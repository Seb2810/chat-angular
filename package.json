{
  "name": "myproject-srr",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm run dev",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "watch:angular": "ng build --watch --configuration development",
    "dev:server": "wait-on dist/myproject-srr/server/server.mjs && nodemon --watch dist/myproject-srr/server/server.mjs --ext mjs --exec \"node dist/myproject-srr/server/server.mjs\"",
    "dev": "pnpm run build:dev && concurrently -k \"pnpm:watch:angular\" \"pnpm:dev:server\"",
    "test": "ng test",
    "serve:ssr:myproject-srr": "node dist/myproject-srr/server/server.mjs",
    "prisma:generate": "prisma generate"
  },

  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@apollo/client": "^4.2.9",
    "@graphql-tools/schema": "^10.0.38",
    "@ng-icons/core": "^31.4.0",
    "@prisma/client": "6.5",
    "apollo-angular": "^14.1.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "flowbite": "^4.0.2",
    "flowbite-angular": "^21.0.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "jose": "^6.2.7",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "ng-primitives": "^0.90.0",
    "nodemon": "^3.1.14",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.6.2",
    "zod": "^4.6.5",
    "zone.js": "~0.15.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },


  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^18.19.130",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^10.0.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.26",
